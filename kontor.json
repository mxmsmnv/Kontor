{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "Kontor",
    "title": "Kontor Core",
    "description": "Service container, capability and component registries, migrations, audit, and the ProcessKontor admin shell.",
    "version": "0.1.0",
    "type": "core",
    "category": "core",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/Kontor",
    "package": "kontor/core",
    "namespace": "Kontor\\Core",
    "processWireModule": "Kontor",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^0.1"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-access",
        "kontor-admin",
        "kontor-components-view",
        "kontor-components-install",
        "kontor-components-update",
        "kontor-components-disable",
        "kontor-components-remove",
        "kontor-audit-view",
        "kontor-health-view"
    ],
    "admin": {
        "sections": [
            {
                "key": "kontor",
                "title": "Kontor",
                "icon": "cubes",
                "order": 0
            }
        ],
        "routes": [
            {
                "path": "components",
                "controller": "ProcessKontor::executeComponents"
            }
        ]
    },
    "services": [],
    "events": {
        "publishes": [
            "component.installed",
            "component.updated",
            "component.enabled",
            "component.disabled",
            "component.uninstalled"
        ],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": []
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_organizations",
            "kontor_components",
            "kontor_migrations",
            "kontor_audit_events",
            "kontor_sequences",
            "kontor_extensions",
            "kontor_relations"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": [],
        "sensitiveData": []
    }
}
