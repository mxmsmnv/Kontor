{
    "name": "kontor/core",
    "description": "Kontor Core: service container, capability/component registries, migrations, audit and the ProcessKontor admin shell for ProcessWire.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "kontor/sdk": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/sdk"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Core\\": "src/",
            "Kontor\\Core\\Migrations\\": "migrations/",
            "Kontor\\Queue\\": "packages/queue/src/",
            "Kontor\\Queue\\Migrations\\": "packages/queue/migrations/",
            "Kontor\\Search\\": "packages/search/src/",
            "Kontor\\Dashboard\\": "packages/dashboard/src/",
            "Kontor\\Dashboard\\Migrations\\": "packages/dashboard/migrations/",
            "Kontor\\Contacts\\": "packages/contacts/src/",
            "Kontor\\Contacts\\Migrations\\": "packages/contacts/migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Core\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
