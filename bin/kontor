#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Kontor\Core\Application\BackupManager;
use Kontor\Core\Infrastructure\Backup\CoreBackupProvider;
use Kontor\Core\Infrastructure\Recovery\RecoveryModeManager;
use Kontor\Core\Infrastructure\Registry\BackupProviderRegistry;

/**
 * Local CLI for demo setup, backup, and recovery.
 */
function kontorFail(string $message): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit(1);
}

function kontorPdo(): PDO
{
    $dsn = getenv('KONTOR_DB_DSN');

    if ($dsn === false) {
        kontorFail('Set KONTOR_DB_DSN (and optionally KONTOR_DB_USER / KONTOR_DB_PASS) to connect to MySQL.');
    }

    return new PDO(
        $dsn,
        getenv('KONTOR_DB_USER') ?: null,
        getenv('KONTOR_DB_PASS') ?: null,
        [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
    );
}

function kontorBackupManager(): BackupManager
{
    $registry = new BackupProviderRegistry();
    $registry->register('core', new CoreBackupProvider(kontorPdo()));

    $backupDir = getenv('KONTOR_BACKUP_DIR') ?: (getcwd() . '/kontor-backups');

    return new BackupManager($registry, $backupDir);
}

function kontorRecovery(): RecoveryModeManager
{
    $stateDir = getenv('KONTOR_STATE_DIR') ?: (getcwd() . '/kontor-state');

    return new RecoveryModeManager($stateDir);
}

/**
 * Plan the demo's dependency closure using the target site's module metadata.
 */
function kontorDemoInstall(string $siteRoot, bool $apply): void
{
    $core = $siteRoot . '/wire/core/ProcessWire.php';
    if (!is_file($siteRoot . '/index.php') || !is_file($core)) {
        kontorFail('Provide the root directory of an installed ProcessWire test site.');
    }

    require_once $core;
    $config = \ProcessWire\ProcessWire::buildConfig($siteRoot);
    if (!$config->dbName) {
        kontorFail('Install ProcessWire before preparing the Kontor demo.');
    }
    if (realpath($config->paths->siteModules . 'Kontor') !== realpath(dirname(__DIR__))) {
        kontorFail('Run this command from the Kontor copy present in the specified test site.');
    }
    $wire = new \ProcessWire\ProcessWire($config);
    $modules = $wire->modules;

    $plan = [];
    $visiting = [];
    $visit = static function (string $name) use ($modules, &$plan, &$visiting, &$visit): void {
        if ($modules->isInstalled($name) || isset($plan[$name])) {
            return;
        }
        if (isset($visiting[$name])) {
            throw new RuntimeException('Circular module dependency involving ' . $name . '.');
        }
        if (!preg_match('/^Kontor[A-Za-z]*$/D', $name) || !$modules->isInstallable($name)) {
            throw new RuntimeException('Unsatisfied dependency: ' . $name . '. Check requirements and run Modules → Refresh.');
        }

        $visiting[$name] = true;
        foreach ($modules->getRequires($name, true) as $dependency) {
            $visit($dependency);
        }
        unset($visiting[$name]);
        $plan[$name] = true;
    };

    try {
        $visit('KontorDemo');
        if ($plan === []) {
            echo 'Kontor Demo is already installed.' . PHP_EOL;
            return;
        }

        echo 'Module install order: ' . implode(' → ', array_keys($plan)) . PHP_EOL;
        if (!$apply) {
            echo 'Preview only. Pass --apply to install these modules on the test site.' . PHP_EOL;
            return;
        }
        foreach (array_keys($plan) as $name) {
            if ($modules->isInstalled($name)) {
                continue;
            }
            if (!$modules->install($name, ['dependencies' => false]) || !$modules->isInstalled($name)) {
                throw new RuntimeException('ProcessWire could not install ' . $name . '.');
            }
            echo 'Installed ' . $name . PHP_EOL;
        }

        echo 'Open Admin → Kontor → Demo and select New scenario.' . PHP_EOL;
    } catch (Throwable $exception) {
        kontorFail($exception->getMessage());
    }
}

$command = $argv[1] ?? null;

switch ($command) {
    case 'demo:install':
        $siteRoot = $argv[2] ?? '';
        $option = $argv[3] ?? null;
        if ($siteRoot === '' || ($option !== null && $option !== '--apply') || count($argv) > 4) {
            kontorFail('Usage: kontor demo:install <processwire-test-root> [--apply]');
        }
        $siteRoot = realpath($siteRoot);
        if ($siteRoot === false) {
            kontorFail('ProcessWire test root does not exist.');
        }
        kontorDemoInstall($siteRoot, $option === '--apply');
        break;

    case 'recovery:enable':
        $reason = $argv[2] ?? 'manual';
        kontorRecovery()->enable($reason);
        echo "Recovery mode enabled: {$reason}" . PHP_EOL;
        break;

    case 'recovery:disable':
        kontorRecovery()->disable();
        echo 'Recovery mode disabled.' . PHP_EOL;
        break;

    case 'recovery:status':
        $recovery = kontorRecovery();
        echo $recovery->isActive() ? 'ACTIVE: ' . $recovery->reason() . PHP_EOL : 'inactive' . PHP_EOL;
        break;

    case 'backup:create':
        $component = $argv[2] ?? kontorFail('Usage: kontor backup:create <component> <kind> <organizationId>');
        $kind = $argv[3] ?? 'component';
        $organizationId = $argv[4] ?? kontorFail('Usage: kontor backup:create <component> <kind> <organizationId>');

        $record = kontorBackupManager()->create($component, $kind, $organizationId);

        echo json_encode([
            'id' => $record->id,
            'path' => $record->path,
            'verified' => $record->verified,
            'itemCount' => $record->itemCount,
            'errors' => $record->verificationErrors,
        ], JSON_PRETTY_PRINT) . PHP_EOL;

        exit($record->verified ? 0 : 1);

    case 'backup:list':
        foreach (kontorBackupManager()->list() as $path) {
            echo $path . PHP_EOL;
        }

        break;

    case 'restore:run':
        $path = $argv[2] ?? kontorFail('Usage: kontor restore:run <path> <component> <organizationId> [--dry-run]');
        $component = $argv[3] ?? kontorFail('Usage: kontor restore:run <path> <component> <organizationId> [--dry-run]');
        $organizationId = $argv[4] ?? kontorFail('Usage: kontor restore:run <path> <component> <organizationId> [--dry-run]');
        $dryRun = in_array('--dry-run', $argv, true);

        $recovery = kontorRecovery();

        if (!$dryRun) {
            $recovery->enable("restore:{$component}");
        }

        $result = kontorBackupManager()->restore($path, $component, $organizationId, $dryRun);

        if (!$dryRun) {
            $recovery->disable();
        }

        echo json_encode([
            'success' => $result->success,
            'restoredCount' => $result->restoredCount,
            'errors' => $result->errors,
        ], JSON_PRETTY_PRINT) . PHP_EOL;

        exit($result->success ? 0 : 1);

    default:
        kontorFail(<<<USAGE
            Usage: kontor <command> [args]

              demo:install <processwire-test-root> [--apply]
              recovery:enable <reason>
              recovery:disable
              recovery:status
              backup:create <component> <kind> <organizationId>
              backup:list
              restore:run <path> <component> <organizationId> [--dry-run]
            USAGE);
}
