{
    "name": "kontor/reports",
    "description": "Kontor Reports: provider registry orchestration, report builder, charts, exports, scheduled reports.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0",
        "kontor/documents": "^1.0",
        "kontor/files": "^1.0",
        "kontor/queue": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "name": "monorepo",
            "type": "path",
            "url": "../*"
        },
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../documents"
        },
        {
            "type": "path",
            "url": "../files"
        },
        {
            "type": "path",
            "url": "../queue"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Reports\\": "src/",
            "Kontor\\Reports\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Reports\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
