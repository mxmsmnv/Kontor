{
    "name": "kontor/catalog",
    "description": "Kontor Catalog: items (products and services), categories, price lists, units of measure and tax code references.",
    "type": "library",
    "license": "MIT",
    "version": "0.2.1",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1",
        "kontor/search": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../search"
        },
        {
            "type": "path",
            "url": "../queue"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Catalog\\": "src/",
            "Kontor\\Catalog\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Catalog\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
