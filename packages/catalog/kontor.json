{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorCatalog",
    "title": "Kontor Catalog",
    "description": "Items (products and services), categories, price lists, units of measure and tax code references.",
    "version": "1.0.0",
    "type": "business",
    "category": "catalog",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorCatalog",
    "package": "kontor/catalog",
    "namespace": "Kontor\\Catalog",
    "processWireModule": "KontorCatalog",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "suggests": {
        "kontor/search": "^1.0"
    },
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-catalog-item-view",
        "kontor-catalog-item-create",
        "kontor-catalog-item-edit",
        "kontor-catalog-item-archive",
        "kontor-catalog-category-view",
        "kontor-catalog-category-create",
        "kontor-catalog-category-edit",
        "kontor-catalog-pricelist-view",
        "kontor-catalog-pricelist-create",
        "kontor-catalog-pricelist-edit",
        "kontor-catalog-export"
    ],
    "admin": {
        "sections": [
            {
                "key": "catalog",
                "title": "Catalog",
                "icon": "cubes",
                "order": 110
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [
            "Kontor\\Catalog\\Infrastructure\\Import\\ItemImportProvider"
        ],
        "export": [
            "Kontor\\Catalog\\Infrastructure\\Export\\ItemExportProvider"
        ],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Catalog\\Health\\CatalogHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_catalog_items",
            "kontor_catalog_categories",
            "kontor_catalog_price_lists",
            "kontor_catalog_prices"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": [],
        "sensitiveData": ["catalog_item.cost_price_minor", "catalog_item.purchase_price_minor"]
    }
}
