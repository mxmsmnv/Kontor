        "kontor/catalog": "^0.1",
        "kontor/sales": "^0.1",
        "kontor/workflow": "^0.1",
        "kontor/tasks": "^0.1",
        "kontor/collaboration": "^0.1",
        "kontor/projects": "^0.1",
        "kontor/invoices": "^0.1",
        "kontor/payments": "^0.1",
        "kontor/files": "^0.1",
