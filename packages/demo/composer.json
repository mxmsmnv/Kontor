{
    "name": "kontor/demo",
    "description": "Kontor Demo: connected order-to-cash scenario across business components.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/core": "^0.1",
        "kontor/contacts": "^0.1",
        "kontor/crm": "^0.1",
        "kontor/catalog": "^0.1",
        "kontor/sales": "^0.1",
        "kontor/workflow": "^0.1",
        "kontor/tasks": "^0.1",
        "kontor/collaboration": "^0.1",
        "kontor/projects": "^0.1",
        "kontor/invoices": "^0.1",
        "kontor/payments": "^0.1",
        "kontor/files": "^0.1",
        "kontor/mail": "^0.1",
        "kontor/ledger": "^0.1",
        "kontor/germany": "^0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Demo\\": "src/",
            "Kontor\\Demo\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Demo\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
