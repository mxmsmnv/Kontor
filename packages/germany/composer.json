{
    "name": "kontor/germany",
    "description": "Kontor Germany: localization contracts, Germany package, country-specific document formats.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0",
        "kontor/ledger": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "name": "monorepo",
            "type": "path",
            "url": "../*"
        },
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../ledger"
        },
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Germany\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Germany\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
