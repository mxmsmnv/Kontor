{
    "name": "kontor/crm-intake",
    "description": "Configurable CRM qualification forms for Kontor contacts, leads and deals.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Maxim Semenov", "homepage": "https://github.com/mxmsmnv"}],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0",
        "kontor/crm": "^1.0"
    },
    "repositories": [
        {
            "name": "monorepo",
            "type": "path",
            "url": "../*"
        },
        {"type": "path", "url": "../sdk"},
        {"type": "path", "url": "../crm"},
        {"type": "path", "url": "../.."}
    ],
    "autoload": {"psr-4": {"Kontor\\CRMIntake\\": "src/"}},
    "autoload-dev": {"psr-4": {"Kontor\\CRMIntake\\Tests\\": "tests/"}},
    "minimum-stability": "stable"
}
