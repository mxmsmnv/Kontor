{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorCRMIntake",
    "title": "Kontor CRM Intake",
    "description": "Configurable qualification forms shared by contacts, leads and deals.",
    "version": "0.1.0",
    "type": "business",
    "category": "crm",
    "license": "MIT",
    "author": {"name": "Maxim Semenov", "url": "https://github.com/mxmsmnv"},
    "repository": "https://github.com/mxmsmnv/Kontor",
    "package": "kontor/crm-intake",
    "namespace": "Kontor\\CRMIntake",
    "processWireModule": "KontorCRMIntake",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/core": "^0.1",
        "kontor/crm": "^0.1"
