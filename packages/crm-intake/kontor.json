    "translations": {"source": "en", "languages": ["en"]},
    "migrations": {"path": "migrations", "supportsRollback": true},
    "storage": {"tables": ["kontor_crm_intake_profiles", "kontor_crm_intake_responses"], "directories": []},
    "cli": [],
    "security": {"externalConnections": [], "sensitiveData": ["CRM qualification answers"], "excludedFromProfiles": ["captured answers", "passwords", "tokens", "secrets"]}
