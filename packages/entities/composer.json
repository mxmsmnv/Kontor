{
    "name": "kontor/entities",
    "description": "Kontor Custom Entities: entity builder, fields, relations, views, permissions, API exposure.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1"
    },
    "suggest": {
        "kontor/api": "Publishes API-exposed custom entity definitions to REST and GraphQL."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "kontor/api": "^0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../api"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Entities\\": "src/",
            "Kontor\\Entities\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Entities\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
