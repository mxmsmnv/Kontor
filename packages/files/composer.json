{
    "name": "kontor/files",
    "description": "Kontor Files: local private storage, file metadata, signed URLs, versions, and the StorageInterface external adapter contract.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2",
        "kontor/core": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Files\\": "src/",
            "Kontor\\Files\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Files\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
