{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorFiles",
    "title": "Kontor Files",
    "description": "Local private storage, file metadata, signed URLs, versions and classifications.",
    "version": "1.0.0",
    "type": "platform",
    "category": "files",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorFiles",
    "package": "kontor/files",
    "namespace": "Kontor\\Files",
    "processWireModule": "KontorFiles",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [
        {
            "name": "storage",
            "version": "1.0",
            "contract": "Kontor\\SDK\\Contracts\\StorageInterface"
        }
    ],
    "permissions": [
        "kontor-files-file-view",
        "kontor-files-file-upload",
        "kontor-files-file-download",
        "kontor-files-file-share",
        "kontor-files-file-delete"
    ],
    "admin": {
        "sections": [],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [
            "file.uploaded",
            "file.version_created",
            "file.archived",
            "file.restored",
            "file.shared"
        ],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Files\\Health\\FilesHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_files"
        ],
        "directories": [
            "site/assets/kontor/files"
        ]
    },
    "cli": [],
    "security": {
        "externalConnections": [],
        "sensitiveData": ["file.original_name", "file.metadata_json"]
    }
}
