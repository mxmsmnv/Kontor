{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorMail",
    "title": "Kontor Mail",
    "description": "Outbound history, inbound adapters, entity linking, shared mailboxes.",
    "version": "1.0.0",
    "type": "platform",
    "category": "communication",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorMail",
    "package": "kontor/mail",
    "namespace": "Kontor\\Mail",
    "processWireModule": "KontorMail",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-mail-mailbox-manage",
        "kontor-mail-message-view",
        "kontor-mail-message-send"
    ],
    "admin": {
        "sections": [
            {
                "key": "mail",
                "title": "Mail",
                "icon": "envelope",
                "order": 900
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": ["mail.sent", "mail.delivery_failed", "mail.received"],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Mail\\Health\\MailHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_mail_mailboxes",
            "kontor_mail_messages"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": ["outbound SMTP/mail transport", "inbound mail forwarding webhook"],
        "sensitiveData": ["message body text", "sender/recipient addresses"]
    }
}
