{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorCollaboration",
    "title": "Kontor Collaboration",
    "description": "Notes, comments, mentions, followers, unread states.",
    "version": "1.0.0",
    "type": "business",
    "category": "collaboration",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorCollaboration",
    "package": "kontor/collaboration",
    "namespace": "Kontor\\Collaboration",
    "processWireModule": "KontorCollaboration",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0",
        "kontor/queue": "^1.0",
        "kontor/mail": "^1.0"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-collaboration-note-view",
        "kontor-collaboration-note-create",
        "kontor-collaboration-note-edit",
        "kontor-collaboration-note-archive",
        "kontor-collaboration-comment-view",
        "kontor-collaboration-comment-create",
        "kontor-collaboration-comment-edit",
        "kontor-collaboration-comment-archive",
        "kontor-collaboration-follow-manage"
    ],
    "admin": {
        "sections": [
            {
                "key": "collaboration",
                "title": "Collaboration",
                "icon": "comments-o",
                "order": 410
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Collaboration\\Health\\CollaborationHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_notes",
            "kontor_comments",
            "kontor_mentions",
            "kontor_followers",
            "kontor_unread_states"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": [],
        "sensitiveData": []
    }
}
