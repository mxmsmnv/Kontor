{
    "name": "kontor/collaboration",
    "description": "Kontor Collaboration: notes, comments, mentions, followers, unread states.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1",
        "kontor/mail": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../mail"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Collaboration\\": "src/",
            "Kontor\\Collaboration\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Collaboration\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
