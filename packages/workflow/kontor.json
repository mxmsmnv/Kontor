{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorWorkflow",
    "title": "Kontor Workflow",
    "description": "State machine, transition permissions, approvals, history.",
    "version": "1.0.0",
    "type": "platform",
    "category": "extensibility",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorWorkflow",
    "package": "kontor/workflow",
    "namespace": "Kontor\\Workflow",
    "processWireModule": "KontorWorkflow",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-workflow-definition-view",
        "kontor-workflow-definition-manage",
        "kontor-workflow-transition",
        "kontor-workflow-approve",
        "kontor-workflow-history-view"
    ],
    "admin": {
        "sections": [
            {
                "key": "workflow",
                "title": "Workflow",
                "icon": "sitemap",
                "order": 600
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Workflow\\Health\\WorkflowHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_workflow_definitions",
            "kontor_workflow_transitions",
            "kontor_workflow_instances",
            "kontor_workflow_approval_requests",
            "kontor_workflow_history"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": [],
        "sensitiveData": []
    }
}
