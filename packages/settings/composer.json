{
    "name": "kontor/settings",
    "description": "Kontor Settings: safe, versioned workspace settings export and import.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "repositories": [
        {
            "name": "monorepo",
            "type": "path",
            "url": "../*"
        },
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Settings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Settings\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
