{
    "name": "kontor/portal",
    "description": "Kontor Portal: customer login, quotations, invoices, payments, files, profile.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1",
        "kontor/contacts": "^0.1",
        "kontor/sales": "^0.1",
        "kontor/invoices": "^0.1",
        "kontor/payments": "^0.1",
        "kontor/files": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../contacts"
        },
        {
            "type": "path",
            "url": "../search"
        },
        {
            "type": "path",
            "url": "../queue"
        },
        {
            "type": "path",
            "url": "../sales"
        },
        {
            "type": "path",
            "url": "../invoices"
        },
        {
            "type": "path",
            "url": "../payments"
        },
        {
            "type": "path",
            "url": "../files"
        },
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Portal\\": "src/",
            "Kontor\\Portal\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Portal\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
