{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorPortal",
    "title": "Kontor Portal",
    "description": "Customer login, quotations, invoices, payments, files, profile.",
    "version": "0.1.0",
    "type": "business",
    "category": "customer-experience",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorPortal",
    "package": "kontor/portal",
    "namespace": "Kontor\\Portal",
    "processWireModule": "KontorPortal",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1",
        "kontor/contacts": "^0.1",
        "kontor/sales": "^0.1",
        "kontor/invoices": "^0.1",
        "kontor/payments": "^0.1",
        "kontor/files": "^0.1"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-portal-account-manage"
    ],
    "admin": {
        "sections": [
            {
                "key": "portal",
                "title": "Portal",
                "icon": "user-circle",
                "order": 920
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Portal\\Health\\PortalHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_portal_accounts"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": [],
        "sensitiveData": ["portal account password hashes", "customer document contents (quotations, invoices, files)"]
    }
}
