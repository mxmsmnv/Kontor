{
    "name": "kontor/crm",
    "description": "Kontor CRM: leads, pipelines, stages, deals, lead-to-deal conversion, Kanban board data and pipeline reports.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0",
        "kontor/contacts": "^1.0",
        "kontor/search": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "name": "monorepo",
            "type": "path",
            "url": "../*"
        },
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../contacts"
        },
        {
            "type": "path",
            "url": "../search"
        },
        {
            "type": "path",
            "url": "../queue"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\CRM\\": "src/",
            "Kontor\\CRM\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\CRM\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
