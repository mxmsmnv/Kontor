{
    "name": "kontor/expenses",
    "description": "Kontor Expenses: expenses, categories, receipts, approvals.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1"
    },
    "suggest": {
        "kontor/workflow": "Adds configurable state, approval-request and history tracking to the safe built-in expense lifecycle."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "kontor/workflow": "^0.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../workflow"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Expenses\\": "src/",
            "Kontor\\Expenses\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Expenses\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
