{
    "name": "kontor/expenses",
    "description": "Kontor Expenses: expenses, categories, receipts, approvals.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "suggest": {
        "kontor/ledger": "Posts reimbursed expenses to the general ledger.",
        "kontor/workflow": "Adds configurable state, approval-request and history tracking to the safe built-in expense lifecycle."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "kontor/workflow": "^1.0"
    },
    "repositories": [
        {
            "name": "monorepo",
            "type": "path",
            "url": "../*"
        },
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../workflow"
        },
        {
            "type": "path",
            "url": "../ledger"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Expenses\\": "src/",
            "Kontor\\Expenses\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Expenses\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
