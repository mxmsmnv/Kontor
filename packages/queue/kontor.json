{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorQueue",
    "title": "Kontor Queue",
    "description": "Asynchronous and delayed jobs, retries, dead-letter queue, priorities and progress.",
    "version": "0.1.1",
    "type": "platform",
    "category": "queue",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorQueue",
    "package": "kontor/queue",
    "namespace": "Kontor\\Queue",
    "processWireModule": "KontorQueue",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^0.2",
        "kontor/core": "^0.1"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [
        {
            "name": "queue",
            "version": "1.0",
            "contract": "Kontor\\SDK\\Contracts\\QueueInterface"
        }
    ],
    "permissions": [
        "kontor-queue-view",
        "kontor-queue-manage",
        "kontor-queue-retry",
        "kontor-queue-cancel"
    ],
    "admin": {
        "sections": [],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [
            "queue.job.dispatched",
            "queue.job.started",
            "queue.job.progress",
            "queue.job.completed",
            "queue.job.retrying",
            "queue.job.dead",
            "queue.job.cancelled"
        ],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Queue\\Health\\QueueHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_jobs"
        ],
        "directories": []
    },
    "cli": [
        {
            "name": "queue:work",
            "handler": "bin/queue"
        },
        {
            "name": "queue:list",
            "handler": "bin/queue"
        },
        {
            "name": "job:dispatch",
            "handler": "bin/queue"
        },
        {
            "name": "job:cancel",
            "handler": "bin/queue"
        }
    ],
    "security": {
        "externalConnections": [],
        "sensitiveData": []
    }
}
