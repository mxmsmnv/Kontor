{
    "name": "kontor/queue",
    "description": "Kontor Queue: asynchronous and delayed jobs, retries, dead-letter queue, priorities, progress, and a CLI worker.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2",
        "kontor/core": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Queue\\": "src/",
            "Kontor\\Queue\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Queue\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
