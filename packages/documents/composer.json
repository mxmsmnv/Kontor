{
    "name": "kontor/documents",
    "description": "Kontor Documents: templates, HTML/PDF rendering, multilingual output, immutable issued-document snapshots.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Documents\\": "src/",
            "Kontor\\Documents\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Documents\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
