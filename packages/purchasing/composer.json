{
    "name": "kontor/purchasing",
    "description": "Kontor Purchasing: suppliers, purchase orders, goods receipt, inventory integration.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1",
        "kontor/sales": "^0.1",
        "kontor/inventory": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../sales"
        },
        {
            "type": "path",
            "url": "../inventory"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Purchasing\\": "src/",
            "Kontor\\Purchasing\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Purchasing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
