{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorMarketplace",
    "title": "Kontor Marketplace",
    "description": "Official registry, custom registry, component metadata, advisories, publisher model.",
    "version": "0.1.0",
    "type": "platform",
    "category": "integration",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorMarketplace",
    "package": "kontor/marketplace",
    "namespace": "Kontor\\Marketplace",
    "processWireModule": "KontorMarketplace",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-marketplace-registry-manage",
        "kontor-marketplace-advisory-view"
    ],
    "admin": {
        "sections": [
            {
                "key": "marketplace",
                "title": "Marketplace",
                "icon": "shopping-cart",
                "order": 810
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Marketplace\\Health\\MarketplaceHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_marketplace_registries",
            "kontor_marketplace_publishers",
            "kontor_marketplace_listings",
            "kontor_marketplace_advisories"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": ["registry sync URLs (outbound HTTP GET)"],
        "sensitiveData": []
    }
}
