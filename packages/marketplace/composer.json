{
    "name": "kontor/marketplace",
    "description": "Kontor Marketplace: official registry, custom registry, component metadata, advisories, publisher model.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Marketplace\\": "src/",
            "Kontor\\Marketplace\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Marketplace\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
