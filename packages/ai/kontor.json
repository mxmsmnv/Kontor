{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorAI",
    "title": "Kontor AI",
    "description": "Provider contract, Squad adapter, summaries, drafting, extraction, approval workflow.",
    "version": "1.0.0",
    "type": "platform",
    "category": "intelligence",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorAI",
    "package": "kontor/ai",
    "namespace": "Kontor\\AI",
    "processWireModule": "KontorAI",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": ["external.approvals"],
    "permissions": [
        "kontor-ai-action-approve"
    ],
    "admin": {
        "sections": [
            {
                "key": "ai",
                "title": "AI",
                "icon": "magic",
                "order": 930
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\AI\\Health\\AIHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_ai_pending_actions",
            "kontor_ai_external_approvals"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": ["Squad AI provider (via a deployment-supplied SquadClientInterface)"],
        "sensitiveData": ["text sent to an AI provider for summarization/drafting/extraction", "redacted external approval references"]
    }
}
