    "version": "0.1.0",
    "type": "business",
    "category": "operations",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorProjects",
    "package": "kontor/projects",
    "namespace": "Kontor\\Projects",
    "processWireModule": "KontorProjects",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1",
        "kontor/sales": "^0.1",
        "kontor/invoices": "^0.1"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-projects-project-view",
        "kontor-projects-project-create",
        "kontor-projects-project-edit",
