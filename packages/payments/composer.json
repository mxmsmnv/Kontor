{
    "name": "kontor/payments",
    "description": "Kontor Payments: payments, allocations, partial payments, reversals.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1",
        "kontor/invoices": "^0.1",
        "kontor/sales": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "kontor/ledger": "Automatically posts invoice-payment allocations and reversals to the general ledger."
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../sales"
        },
        {
            "type": "path",
            "url": "../invoices"
        },
        {
            "type": "path",
            "url": "../ledger"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Payments\\": "src/",
            "Kontor\\Payments\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Payments\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
