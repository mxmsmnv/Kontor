{
    "name": "kontor/search",
    "description": "Kontor Search: a provider registry, federated global search, a reusable SQL full-text provider and an asynchronous indexing queue.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0",
        "kontor/queue": "^1.0",
        "kontor/cache": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "name": "monorepo",
            "type": "path",
            "url": "../*"
        },
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        },
        {
            "type": "path",
            "url": "../queue"
        },
        {
            "type": "path",
            "url": "../cache"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Search\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
