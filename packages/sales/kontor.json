    "type": "business",
    "category": "sales",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorSales",
    "package": "kontor/sales",
    "namespace": "Kontor\\Sales",
    "processWireModule": "KontorSales",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "suggests": {
        "kontor/contacts": "^1.0",
        "kontor/catalog": "^1.0",
