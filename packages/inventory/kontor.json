{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorInventory",
    "title": "Kontor Inventory",
    "description": "Warehouses, balances, movements, reservations, transfers, barcode support.",
    "version": "0.1.0",
    "type": "business",
    "category": "operations",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorInventory",
    "package": "kontor/inventory",
    "namespace": "Kontor\\Inventory",
    "processWireModule": "KontorInventory",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1"
    },
    "suggests": {
        "kontor/catalog": "^0.1",
        "kontor/purchasing": "^0.1"
    },
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-inventory-stock-view",
        "kontor-inventory-movement-view",
        "kontor-inventory-receive",
        "kontor-inventory-transfer",
        "kontor-inventory-adjust",
        "kontor-inventory-reserve",
        "kontor-inventory-release",
        "kontor-inventory-negative-stock-override",
        "kontor-inventory-warehouse-admin"
    ],
    "admin": {
        "sections": [
            {
                "key": "inventory",
                "title": "Inventory",
                "icon": "cubes",
                "order": 500
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [
            "inventory.movement.completed"
        ],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Inventory\\Health\\InventoryHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_inventory_warehouses",
            "kontor_inventory_balances",
            "kontor_inventory_movements",
            "kontor_inventory_barcodes"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": [],
        "sensitiveData": []
    }
}
