{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorAutomation",
    "title": "Kontor Automation",
    "description": "Triggers, conditions, actions, dry run, logs, recursion protection.",
    "version": "1.0.0",
    "type": "platform",
    "category": "extensibility",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorAutomation",
    "package": "kontor/automation",
    "namespace": "Kontor\\Automation",
    "processWireModule": "KontorAutomation",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^1.0",
        "kontor/core": "^1.0"
    },
    "suggests": {},
    "conflicts": {},
    "capabilities": [],
    "permissions": [
        "kontor-automation-rule-view",
        "kontor-automation-rule-manage",
        "kontor-automation-dry-run",
        "kontor-automation-log-view"
    ],
    "admin": {
        "sections": [
            {
                "key": "automation",
                "title": "Automation",
                "icon": "bolt",
                "order": 610
            }
        ],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Automation\\Health\\AutomationHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": "migrations",
        "supportsRollback": true
    },
    "storage": {
        "tables": [
            "kontor_automation_rules",
            "kontor_automation_conditions",
            "kontor_automation_actions",
            "kontor_automation_execution_logs"
        ],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": [],
        "sensitiveData": []
    }
}
