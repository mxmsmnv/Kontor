{
    "name": "kontor/cache",
    "description": "Kontor Cache: namespaces, tag-based invalidation, a ProcessWire adapter and a Redis adapter.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Maxim Semenov",
            "homepage": "https://github.com/mxmsmnv"
        }
    ],
    "require": {
        "php": ">=8.2",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdk"
        },
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Kontor\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kontor\\Cache\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
