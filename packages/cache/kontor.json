{
    "$schema": "https://kontor.dev/schema/component.v1.json",
    "schemaVersion": 1,
    "name": "KontorCache",
    "title": "Kontor Cache",
    "description": "Namespaced, tag-invalidated caching over a swappable store (ProcessWire, Redis, in-memory).",
    "version": "0.1.0",
    "type": "platform",
    "category": "cache",
    "license": "MIT",
    "author": {
        "name": "Maxim Semenov",
        "url": "https://github.com/mxmsmnv"
    },
    "repository": "https://github.com/mxmsmnv/KontorCache",
    "package": "kontor/cache",
    "namespace": "Kontor\\Cache",
    "processWireModule": "KontorCache",
    "requires": {
        "php": ">=8.2",
        "processwire": ">=3.0.240",
        "kontor/sdk": "^0.2.1",
        "kontor/core": "^0.1"
    },
    "suggests": {
        "ext-redis": "Enables RedisCacheStore as an alternative to the ProcessWire-backed store."
    },
    "conflicts": {},
    "capabilities": [
        {
            "name": "cache",
            "version": "1.0",
            "contract": "Kontor\\SDK\\Contracts\\CacheInterface"
        }
    ],
    "permissions": [],
    "admin": {
        "sections": [],
        "routes": []
    },
    "services": [],
    "events": {
        "publishes": [],
        "subscribes": []
    },
    "providers": {
        "backup": null,
        "import": [],
        "export": [],
        "search": [],
        "reports": [],
        "health": [
            "Kontor\\Cache\\Health\\CacheHealthCheck"
        ]
    },
    "translations": {
        "source": "en",
        "languages": ["en", "fr", "de", "es"]
    },
    "migrations": {
        "path": null,
        "supportsRollback": false
    },
    "storage": {
        "tables": [],
        "directories": []
    },
    "cli": [],
    "security": {
        "externalConnections": ["redis (optional, if configured)"],
        "sensitiveData": []
    }
}
